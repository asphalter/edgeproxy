{
	email {$ACME_EMAIL:admin@example.com}
	log access {
		output file {$ACCESS_LOG_PATH:/data/caddy/logs/access.jsonl} {
			roll_size 20mb
			roll_keep 5
			roll_keep_for 14d
		}
		format json
		include http.log.access
		level INFO
	}
}

# Reusable snippet for JSON structured access logging
(access_log) {
	log {
		output file {$ACCESS_LOG_PATH:/data/caddy/logs/access.jsonl} {
			roll_size 20mb
			roll_keep 5
			roll_keep_for 14d
		}
		format json
	}
}

# Default fallback for direct IP and unmatched HTTP requests
:80 {
	header {
		Server "EdgeProxy"
	}
	respond "Unauthorized" 401 {
		close
	}
}

# Default fallback for direct IP and unmatched HTTPS requests
:443 {
	tls internal
	header {
		Server "EdgeProxy"
	}
	respond "Unauthorized" 401 {
		close
	}
}

# Apex / base domain: default public gateway
{$DOMAIN:example.com} {
	import access_log
	header {
		Server "EdgeProxy"
	}
	request_body {
		max_size 100MB
	}
	@hidden_files path */.*
	handle @hidden_files {
		respond "404 Not Found" 404 {
			close
		}
	}
	respond "Unauthorized" 401 {
		close
	}
}

# Reusable snippet for forward_auth with Google OAuth2 (oauth2-proxy)
(google_auth) {
	forward_auth {$OAUTH2_PROXY_ADDR:127.0.0.1:4180} {
		uri /oauth2/auth
		copy_headers X-Auth-Request-User X-Auth-Request-Email
		header_up -X-Auth-Request-User
		header_up -X-Auth-Request-Email
		@unauth status 401
		handle_response @unauth {
			redir https://auth.{$DOMAIN:example.com}/oauth2/start?rd={scheme}://{host}{uri}
		}
	}
	handle_errors 401 {
		redir https://auth.{$DOMAIN:example.com}/oauth2/start?rd={scheme}://{host}{uri}
	}
}

# Dedicated Manager UI domain (automatic Google OAuth2 protection if configured)
manager.{$DOMAIN:example.com} {
	import access_log
	header {
		Server "EdgeProxy"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
	}
	request_body {
		max_size 100MB
	}
	@hidden_files path */.*
	handle @hidden_files {
		respond "404 Not Found" 404 {
			close
		}
	}
	reverse_proxy {$MANAGER_ADDR:127.0.0.1:8000} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up -X-Auth-Request-User
		header_up -X-Auth-Request-Email
	}
}

# Auth portal domain (OAuth2-Proxy endpoints and client config API sync)
auth.{$DOMAIN:example.com} {
	import access_log
	header {
		Server "EdgeProxy"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
	}
	request_body {
		max_size 100MB
	}
	@hidden_files path */.*
	handle @hidden_files {
		respond "404 Not Found" 404 {
			close
		}
	}
	@api_client path /api/v1/client/*
	handle @api_client {
		log_skip
		reverse_proxy {$MANAGER_ADDR:127.0.0.1:8000} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up -X-Auth-Request-User
			header_up -X-Auth-Request-Email
		}
	}
	handle {
		reverse_proxy {$OAUTH2_PROXY_ADDR:127.0.0.1:4180} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up -X-Auth-Request-User
			header_up -X-Auth-Request-Email
		}
	}
}

