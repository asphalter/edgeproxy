# Reusable snippet for JSON structured access logging
(access_log) {
	log {
		output file {$ACCESS_LOG_PATH:/data/caddy/logs/access.jsonl} {
			roll_size 20mb
			roll_keep 5
			roll_keep_for 14d
		}
		format json
	}
}

# Apex / base domain: default public gateway
{$DOMAIN:edge.mpv.cx} {
	import access_log
	respond "EdgeProxy Gateway" 200
}

# Reusable snippet for forward_auth with Google OAuth2 (oauth2-proxy)
(google_auth) {
	forward_auth {$OAUTH2_PROXY_ADDR:127.0.0.1:4180} {
		uri /oauth2/auth
		copy_headers X-Auth-Request-User X-Auth-Request-Email
		@unauth status 401
		handle_response @unauth {
			redir https://auth.{$DOMAIN:edge.mpv.cx}/oauth2/start?rd={scheme}://{host}{uri}
		}
	}
	handle_errors 401 {
		redir https://auth.{$DOMAIN:edge.mpv.cx}/oauth2/start?rd={scheme}://{host}{uri}
	}
}

# Dedicated Manager UI domain (automatic Google OAuth2 protection if configured)
manager.{$DOMAIN:edge.mpv.cx} {
	import access_log
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy {$MANAGER_ADDR:127.0.0.1:8000} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}

# Auth portal domain (OAuth2-Proxy endpoints and client config API sync)
auth.{$DOMAIN:edge.mpv.cx} {
	import access_log
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	handle /api/v1/client/* {
		reverse_proxy {$MANAGER_ADDR:127.0.0.1:8000} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		reverse_proxy {$OAUTH2_PROXY_ADDR:127.0.0.1:4180} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}

